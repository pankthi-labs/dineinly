{
	"extends": "@workspace/typescript-config/nextjs.json",
	"compilerOptions": {
		"paths": {
			"@/*": ["./*"],
			"@workspace/ui/*": ["../../packages/ui/src/*"],
			"@workspace/db": ["../../packages/db/src/index.ts"],
			"@workspace/db/schema": ["../../packages/db/src/schema/index.ts"]
		}
	},
	"include": [
		"next-env.d.ts",
		"next.config.ts",
		"**/*.ts",
		"**/*.tsx",
		"**/*.mts",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
