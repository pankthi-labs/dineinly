{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalDependencies": [".env"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": [
				"NEXT_PUBLIC_SUPABASE_URL",
				"NEXT_PUBLIC_SUPABASE_ANON_KEY",
				"VERCEL_URL"
			],
			"passThroughEnv": ["GUEST_JWT_SIGNING_KEY"],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"//#lint": {},
		"//#test": {
			"cache": false
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
