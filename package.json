{
	"name": "dineinly",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"prepare": "simple-git-hooks",
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "turbo typecheck && tsc --noEmit -p e2e",
		"test": "vitest run",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:generate": "pnpm --filter @workspace/db db:generate",
		"db:migrate": "supabase migration up",
		"db:reset": "supabase db reset",
		"db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:sign-in": "playwright test sign-in",
		"test:e2e:admin-restaurants": "playwright test admin-restaurants",
		"test:e2e:admin-staff": "playwright test admin-staff",
		"test:e2e:staff-roster": "playwright test staff-roster",
		"test:e2e:station-pairing": "playwright test station-pairing",
		"test:e2e:menu": "playwright test menu",
		"test:e2e:tables": "playwright test tables",
		"test:e2e:kitchen": "playwright test kitchen",
		"test:e2e:floor": "playwright test floor",
		"test:e2e:bills": "playwright test bills",
		"test:e2e:guest-ordering": "playwright test guest-ordering",
		"test:e2e:settings": "playwright test settings"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@playwright/test": "^1.62.1",
		"@types/node": "^24.13.3",
		"@workspace/typescript-config": "workspace:*",
		"simple-git-hooks": "^2.13.1",
		"supabase": "^2.109.1",
		"turbo": "^2.10.5",
		"typescript": "^6.0.2",
		"vitest": "^4.1.10"
	},
	"simple-git-hooks": {
		"pre-push": "pnpm turbo typecheck lint test build"
	},
	"packageManager": "pnpm@11.15.1",
	"engines": {
		"node": ">=24.18.0 <25"
	}
}
