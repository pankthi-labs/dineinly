{
	"name": "dineinly",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"prepare": "simple-git-hooks",
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"format": "turbo format",
		"typecheck": "turbo typecheck",
		"test": "vitest run",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:generate": "pnpm --filter @workspace/db db:generate",
		"db:migrate": "supabase migration up",
		"db:reset": "supabase db reset"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@workspace/typescript-config": "workspace:*",
		"simple-git-hooks": "^2.13.1",
		"supabase": "^2.109.1",
		"turbo": "^2.10.5",
		"typescript": "^6.0.2",
		"vitest": "^4.1.10"
	},
	"simple-git-hooks": {
		"pre-push": "pnpm turbo typecheck lint test build"
	},
	"packageManager": "pnpm@11.15.1",
	"engines": {
		"node": ">=24.18.0 <25"
	}
}
