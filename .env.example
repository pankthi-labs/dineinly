DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase local dev — get these from `supabase status -o env` after
# `pnpm db:start`. Copy the real values into .env (gitignored), never here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private JWK used to sign guest JWTs (RS256). Generate together with
# supabase/signing_keys.json via `supabase gen signing-key --algorithm RS256`
# — see supabase/config.toml `signing_keys_path` and README for the full
# setup steps. Must be the exact key Supabase's auth service trusts, or
# guest tokens will be rejected.
GUEST_JWT_SIGNING_KEY=
